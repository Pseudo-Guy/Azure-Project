{
  "$schema": "https://schema.management.azure.com/schemas/2019-09-01/policyDefinition.json#",
  "name": "enforce-cost-management-tags",
  "properties": {
    "displayName": "Require Environment and Owner Tags for Cost Tracking",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "Enforces mandatory 'Environment' and 'Owner' tags on all resource groups and resources for cost management, chargeback, and ownership tracking.",
    "metadata": {
      "category": "Cost Management",
      "version": "1.0.0",
      "author": "Arighna Sadhu"
    },
    "policyRule": {
      "if": {
        "anyOf": [
          {
            "field": "tags['Environment']",
            "exists": "false"
          },
          {
            "field": "tags['Owner']",
            "exists": "false"
          }
        ]
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}
